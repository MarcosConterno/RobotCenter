# Supabase Cloud — Project URL e Publishable key disponíveis em Connect/API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Use somente em código de servidor quando a futura integração administrativa exigir.
# Nunca prefixe esta variável com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA_AQUI
