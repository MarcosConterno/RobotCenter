# Portainer/Swarm variables. Secret values stay in Docker Secrets, not this file.
ROBOT_CENTER_IMAGE=ghcr.io/organization/robot-center:sha-REPLACE_WITH_COMMIT
APP_PUBLISHED_PORT=3000
DATABASE_POOL_MAX=5
DATABASE_URL_SECRET_NAME=robot-center-database-url
DATABASE_ADMIN_URL_SECRET_NAME=robot-center-database-admin-url
DOCUMENT_STORAGE_VOLUME_NAME=robot-center-document-storage
